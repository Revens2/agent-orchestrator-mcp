# /srv/orch/secrets/orch.env (0640 root:orch-app) -- AUCUNE valeur reelle dans Git.
ORCH_DATA_DIR=/srv/orch/data
ORCH_UPSTREAM_PORT=8802
# runner_id:sha256(jeton). Le jeton est genere et chiffre DPAPI sur le PC
# (python -m orch_runner gen-token) : seule l'empreinte arrive ici.
ORCH_RUNNER_TOKENS=main-windows-pc:<sha256hex>
ORCH_RUNNER_CIDRS=10.200.0.0/16

ORCH_GW_PORT=8801
ORCH_GW_UPSTREAM=http://127.0.0.1:8802
ORCH_GW_ISSUER=https://mymcps.duckdns.org/oauth/orch
ORCH_GW_OAUTH_DIR=/srv/orch/data/oauth
# empreinte PBKDF2 de la phrase de passe de consentement (meme format que tasks)
ORCH_GW_CONSENT_HASH=<pbkdf2>
# pas de jeton statique : ORCH_GW_TOKEN volontairement absent
