# /srv/autopilot/secrets/autopilot.env (root:orch-app 640). Aucun secret requis en staging.
# Port local LIBRE a verifier sur l'hote (ss -ltn) : 8801/8802/8803 deja utilises par orch.
AUTOPILOT_PORT=
AUTOPILOT_DATA_DIR=/srv/autopilot/data
AUTOPILOT_BROKER_URL=http://127.0.0.1:8802/mcp
AUTOPILOT_RUNNER_ID=main-windows-pc
# Apres installation du runner isole : AUTOPILOT_RUNNER_ID=autopilot-win-01
# Workspaces allowlistes pour l'autopilot (doivent exister cote runner). Sandbox uniquement.
AUTOPILOT_WORKSPACES=e2e
# Kinds autorises. local_write exige un runner isole (jamais main-windows-pc), sa cle publique Ed25519
# et le SID du compte agent : chaque job doit joindre une enveloppe signee (manifeste + attestation OS).
# La variable AUTOPILOT_RUNNER_DEDICATED_ACCOUNT est SUPPRIMEE : sa presence bloque le demarrage.
AUTOPILOT_ALLOWED_KINDS=read,decision
# AUTOPILOT_RUNNER_PUBKEY=<64 hex, affiche par le runner autopilot-win-01 a l'installation>
# AUTOPILOT_EXPECTED_AGENT_SID=<S-1-5-21-...-xxxx du compte agent>
# Cockpit : jeton exige meme sur la boucle locale (fichier root:orch-app 0640, 32+ caracteres).
AUTOPILOT_COCKPIT_TOKEN_FILE=/srv/autopilot/secrets/cockpit.token
# Garde disque : refus des nouvelles missions/jobs sous ce seuil (alerte via le canal hors bande).
AUTOPILOT_MIN_FREE_MB=2048
AUTOPILOT_MAX_DISK_PCT=95
AUTOPILOT_DAILY_MAX_JOBS=50
AUTOPILOT_TICK_S=5
# Canal hors bande des codes d'approbation (fichiers 0600 lus par l'operateur) ou commande (JSON argv, stdin).
AUTOPILOT_NOTIFY_DIR=/srv/autopilot/data/approvals
# AUTOPILOT_NOTIFY_CMD=["/usr/local/bin/<script-alerte-existant>"]
# Gate Opus : laisser vide => PENDING_GATE systematique (modele servi non atteste a ce jour).
# Opus est local : passerelle a jeton 127.0.0.1:8796 (8794 est sans auth et filtre par nft : ne pas l'ouvrir).
# Aucun changement IPAddressAllow requis (localhost).
# AUTOPILOT_OPUS_URL=http://127.0.0.1:8796/mcp
# AUTOPILOT_OPUS_TOKEN_FILE=/srv/autopilot/secrets/opus.token
# AUTOPILOT_EXPECTED_SERVED_MODEL=
