# /srv/autopilot/secrets/autopilot-gw.env — instance orch-gateway dediee au cockpit.
ORCH_GW_POLICY=autopilot
ORCH_GW_ISSUER=https://<domaine>/oauth/autopilot
ORCH_GW_UPSTREAM=http://127.0.0.1:<AUTOPILOT_PORT>
# Port local LIBRE a verifier sur l'hote.
ORCH_GW_PORT=
ORCH_GW_OAUTH_DIR=/srv/autopilot/gw-oauth
