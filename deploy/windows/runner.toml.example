# %USERPROFILE%\.orch-runner\runner.toml — config locale du runner (hors Git, aucun secret ici).
runner_id = "main-windows-pc"
broker_url = "http://10.200.114.203:8803"
max_parallel = 2
offline_kill_s = 120

# unattended (défaut) : workspace_write sans aucune demande d'autorisation (shell compris).
# guarded : éditions seules, le reste refusé sans prompt ; opencode read_only uniquement.
# read_only reste lecture seule dans les deux cas. Changer puis relancer la tâche orch-runner.
default_permission_policy = "unattended"

# Carte d'identité LISIBLE de cette machine : sert à la nommer dans une phrase
# (« le PC du bureau ») plutôt que par son identifiant. Facultatif — un champ
# non déclaré reste absent côté broker, jamais deviné. hostname et OS sont
# observés automatiquement, ne les mettez pas ici. Aucun chemin, aucun secret.
[machine]
label = "PC principal (bureau)"
role = "poste de travail Windows personnel"
description = "Machine qui héberge Claude Code, Codex, OpenCode et Claude Desktop"

# Ouverture de chaque conversation d'agent.
# start_skill : invoqué en PREMIÈRE ligne du prompt, uniquement sur les runtimes
#   qui comprennent les commandes `/skill` (claude-code aujourd'hui). Les autres
#   ne le reçoivent pas du tout, plutôt que de le lire comme du texte.
#   "" désactive complètement l'invocation.
# subagents : autorise explicitement la délégation à des sous-agents, sur les
#   runtimes qui les documentent (claude-code, opencode). Ailleurs, rien n'est
#   dit : on ne promet pas une capacité non vérifiée.
# Rien de tout cela n'est réinjecté quand une conversation est REPRISE.
[session]
start_skill = "/caveman ultra"
subagents = true

[runtimes.claude-code]
enabled = true
exe = 'C:\Users\<user>\.local\bin\claude.exe'

[runtimes.codex]
enabled = true
exe = 'C:\Users\<user>\AppData\Local\Programs\OpenAI\Codex\bin\codex.exe'

[runtimes.agy]
enabled = true
exe = 'C:\Users\<user>\AppData\Local\Microsoft\WinGet\Packages\Google.AntigravityCLI_Microsoft.Winget.Source_8wekyb3d8bbwe\agy.exe'

[runtimes.opencode]
enabled = true
exe = 'C:\Users\<user>\AppData\Local\Microsoft\WinGet\Packages\SST.opencode_Microsoft.Winget.Source_8wekyb3d8bbwe\opencode.exe'
model = "opencode/muse-spark-1.3-contributor-free"   # épinglé : ne dépend pas du défaut global opencode
# probe_generation = true    # génération "Reply OK." au démarrage ; échec => available=false
# probe_timeout_s = 120

[runtimes.claude-desktop]
# Pilote l'application Claude Desktop (MSIX, éditeur Anthropic) via UIA (.NET
# UIAutomationClient, sans clic à coordonnées fixes).
# `exe` = interpréteur Python (le bridge est un module, comme `fake`).
# Deux modes : `read_only` (réponse seule) et `workspace_write` par VOIE PATCH
# CONFINÉE (le Desktop propose des diffs, le runner les applique bornés au
# workspace — jamais d'accès disque/shell pour le Desktop, voir OPERATIONS.md).
# Désactivé par défaut : activer seulement sur le PC qui héberge le Desktop,
# après vérification du profil (jamais de bascule de compte automatique).
enabled = false
exe = 'C:\Users\<user>\AppData\Local\Programs\Python\Python311\python.exe'
# profile = "Caroline"       # défaut : $ORCH_CLAUDE_DESKTOP_PROFILE sinon "Caroline"
# timeout_s = 3000           # borne interne du bridge (le runner tue à timeout_s du job)
# verify_timeout_s = 90      # borne du probe --verify-only au (re)démarrage du runner

[workspaces.e2e]
path = 'C:\Users\<user>\orch-workspaces\e2e'
modes = ["read_only", "workspace_write"]
description = "Workspace de test E2E de l'orchestrateur (fixtures jetables)"

# Clone réel du dépôt agent-orchestrator-mcp sur ce PC : workspace explicite,
# borné au seul sous-dossier du clone (jamais orch-workspaces entier ni le disque).
# read_only par défaut (lecture / audit) ; ajouter "workspace_write" seulement si
# un agent doit modifier ce clone. Sans cette section, tout accès hors cwd (e2e)
# est refusé (opencode : refus type external_directory).
[workspaces.agent-orchestrator-mcp]
path = 'C:\Users\<user>\orch-workspaces\agent-orchestrator-mcp'
modes = ["read_only"]
description = "Clone réel Revens2/agent-orchestrator-mcp (lecture par défaut)"

# Exemple : projet local modifiable via claude-desktop (voie patch confinée).
# Le Desktop propose des diffs, le runner les applique bornés à CE dossier ;
# le Desktop n'a aucun accès disque/shell. N'ajouter "workspace_write" que sur
# des dossiers de travail dédiés (jamais un disque entier ni un dossier système).
# [workspaces.watchy]
# path = 'C:\projet\Watchy\Watchy'
# modes = ["read_only", "workspace_write"]
# description = "Watchy : dev local via Claude Desktop (patchs confinés) + localhost manuel"
